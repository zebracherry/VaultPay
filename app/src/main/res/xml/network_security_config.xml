<?xml version="1.0" encoding="utf-8"?>
<!-- [M5 / MASVS-NETWORK-1] Cleartext permitted for all domains; user CAs trusted ->
     Burp/mitmproxy intercept works with no pinning to defeat. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
